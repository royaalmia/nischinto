{
  "name": "nischinto-crm",
  "version": "1.0.0",
  "description": "Nischinto - Next-Gen E-commerce Automation, Logistics & AI Ad Operating System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/patch-opennext.js && prisma generate",
    "build": "node scripts/patch-opennext.js && prisma generate && next build && npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion --skipNextBuild",
    "build:next": "next build",
    "start": "next start",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.167.0"
  },
  "devDependencies": {}
}
